{
  "manifest_version": 3,
  "name": "DataPrune DEV v0.2.0",
  "version": "0.2.0",
  "description": "AROL-powered LLM optimization. 90% token reduction. Military-grade encryption. Patent pending.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://api.venice.ai/*",
    "https://api.openai.com/*",
    "https://api.fenton-creative.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/arol-engine.js",
        "content/dlp-scanner.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pages/*"],
      "matches": ["<all_urls>"]
    }
  ]
}